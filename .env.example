# Copy to .env and fill in. .env is gitignored — never commit real values.

# Owls Insight API key — https://owlsinsight.com/dashboard/keys
OWLS_API_KEY=

# Discord bot token
DISCORD_TOKEN=

# Channel for +EV alerts
DISCORD_ALERT_CHANNEL_ID=

# Channel for health and quota warnings (kept separate so alerts stay signal-only)
DISCORD_OPS_CHANNEL_ID=
